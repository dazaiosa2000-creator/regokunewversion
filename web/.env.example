# Apps Script Web App URL (ends in /exec). See ../SETUP.md. Leave empty until deployed.
VITE_APPS_SCRIPT_URL=
# Instagram profile URL. Leave empty to hide the footer link.
VITE_INSTAGRAM_URL=
# FormSubmit target for order emails, used when VITE_APPS_SCRIPT_URL is empty.
# Defaults to dazaiosa2000@gmail.com. After activating, replace it with the alias FormSubmit gives you. "off" disables it.
VITE_FORMSUBMIT_EMAIL=
